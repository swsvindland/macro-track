{
  "expo": {
    "name": "Vector Macros",
    "slug": "macro-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "macrotrack",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#007088",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "dev.svindland.vector.macro",
      "appleTeamId": "9HAG9PT8LJ",
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.svindland.vector.macro"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Macros",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#22d3ee"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.WRITE_HEIGHT",
        "android.permission.health.WRITE_BODY_FAT",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.CAMERA"
      ],
      "package": "dev.svindland.vector.macro"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#22d3ee",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#071017"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose progress photos to save privately in Vector Macros.",
          "cameraPermission": "Take progress photos to save privately in Vector Macros.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "nl",
            "sv",
            "ja",
            "ko",
            "zh-Hans"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Import your weight and height, and read your birthday and sex to fill in your program, when you choose to sync.",
          "NSHealthUpdateUsageDescription": "Save the food you log in Vector Macros as calories, protein, carbs, fat, fiber and sodium, along with your weight, height, waist circumference and recorded body fat, to Apple Health when you choose to sync."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      "./plugins/with-scene-lifecycle",
      [
        "./plugins/with-launcher-name",
        {
          "name": "Macros"
        }
      ],
      [
        "./plugins/with-kotlin-plugin-version",
        {
          "version": "2.2.21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.2.21"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes with Vector Macros.",
          "recordAudioAndroid": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0246986b-8fd7-4909-aa44-b4ae05678608"
      }
    }
  }
}
