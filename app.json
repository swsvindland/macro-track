{
  "expo": {
    "name": "Macro Track",
    "slug": "macro-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "macrotrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "dev.svindland.vector.macro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#22d3ee"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.WRITE_HEIGHT",
        "android.permission.health.WRITE_BODY_FAT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.CAMERA"
      ],
      "package": "dev.svindland.vector.macro"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#22d3ee",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#071017"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose progress photos to save privately in Macro Track.",
          "cameraPermission": "Take progress photos to save privately in Macro Track.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Import your weight and height into Macro Track when you choose to sync.",
          "NSHealthUpdateUsageDescription": "Save your Macro Track weight, height, waist circumference and recorded body fat to Apple Health when you choose to sync."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      "./plugins/with-scene-lifecycle",
      [
        "./plugins/with-kotlin-plugin-version",
        {
          "version": "2.2.21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.2.21"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes with Macro Track.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0246986b-8fd7-4909-aa44-b4ae05678608"
      }
    }
  }
}
