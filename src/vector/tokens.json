{
  "$comment": "Vector Kit single source of truth. `node scripts/vector-kit.mjs gen` writes the TOKENS block of src/vector/tokens.css, src/vector/tokens.ts and the TOKENS block of targets/_shared/VectorTheme.swift from this file. Values are sRGB hex. A value starting with '@' references another token (emitted as var(--x) in CSS, resolved to hex for TS/Swift). hcLight/hcDark apply under iOS Increase Contrast / Android high text contrast.",
  "kit": "vector",
  "version": "1.3.1",
  "fonts": {
    "$comment": "Shipped default uses ONLY the bundled files. Keys are the useFonts() aliases every app registers. The optional block is enabled when the owner supplies static faces (DESIGN_SYSTEM §3.1).",
    "files": {
      "Inter": "assets/fonts/Inter.ttf",
      "IBMPlexMono": "assets/fonts/IBMPlexMono-Regular.ttf"
    },
    "families": {
      "sans": "Inter",
      "normal": "Inter",
      "medium": "Inter",
      "semibold": "Inter",
      "bold": "Inter",
      "mono": "IBMPlexMono"
    },
    "optional": {
      "Inter-Regular": "assets/fonts/Inter-Regular.ttf",
      "Inter-Medium": "assets/fonts/Inter-Medium.ttf",
      "Inter-SemiBold": "assets/fonts/Inter-SemiBold.ttf",
      "Inter-Bold": "assets/fonts/Inter-Bold.ttf",
      "IBMPlexMono-Light": "assets/fonts/IBMPlexMono-Light.ttf",
      "IBMPlexMono-Medium": "assets/fonts/IBMPlexMono-Medium.ttf"
    }
  },
  "text": {
    "xs": [12, 16],
    "sm": [14, 20],
    "base": [16, 24],
    "lg": [17, 22],
    "xl": [20, 26],
    "2xl": [22, 28],
    "3xl": [28, 34],
    "4xl": [34, 40],
    "5xl": [48, 52]
  },
  "tracking": {
    "tight": "0em",
    "label": "0.08em"
  },
  "radius": {
    "radius": 4,
    "radius-xs": 1,
    "radius-sm": 2,
    "radius-md": 4,
    "radius-lg": 4,
    "radius-xl": 4,
    "radius-2xl": 4,
    "radius-3xl": 4,
    "radius-4xl": 4,
    "field-radius": 4,
    "radius-mark": 2,
    "radius-control": 4,
    "radius-panel": 4
  },
  "static": {
    "border-width": "1px",
    "field-border-width": "1px",
    "opacity-disabled": "0.4"
  },
  "color": {
    "background": { "light": "#FFFFFF", "dark": "#071017", "swift": "background" },
    "foreground": { "light": "#15212B", "dark": "#F3F6F7", "hcLight": "#071017", "hcDark": "#FFFFFF", "swift": "foreground" },
    "surface": { "light": "#FFFFFF", "dark": "#0D171E", "swift": "surface" },
    "surface-foreground": { "light": "@foreground", "dark": "@foreground" },
    "surface-secondary": { "light": "#F7F9FA", "dark": "#111D25", "swift": "surfaceSecondary" },
    "surface-secondary-foreground": { "light": "@foreground", "dark": "@foreground" },
    "surface-tertiary": { "light": "#F1F5F7", "dark": "#15232C", "swift": "surfaceTertiary" },
    "surface-tertiary-foreground": { "light": "@foreground", "dark": "@foreground" },
    "overlay": { "light": "#FFFFFF", "dark": "#111D25" },
    "overlay-foreground": { "light": "@foreground", "dark": "@foreground" },
    "backdrop": { "light": "rgba(7, 16, 23, 0.24)", "dark": "rgba(0, 0, 0, 0.5)" },
    "muted": { "light": "#5F6D78", "dark": "#93A0A8", "hcLight": "#3E4D57", "hcDark": "#C8D1D6", "swift": "muted" },
    "default": { "light": "#F1F5F7", "dark": "#15232C" },
    "default-foreground": { "light": "@foreground", "dark": "@foreground" },
    "accent": { "light": "#22D3EE", "dark": "#22D3EE", "swift": "signal" },
    "accent-foreground": { "light": "#071017", "dark": "#071017", "hcLight": "#000000", "hcDark": "#000000", "swift": "signalInk" },
    "accent-soft": { "light": "#ECFEFF", "dark": "#083344" },
    "accent-soft-foreground": { "light": "#007088", "dark": "#67E8F9", "hcLight": "#00566B", "hcDark": "#A5F3FC" },
    "field-background": { "light": "#FFFFFF", "dark": "#0D171E" },
    "field-foreground": { "light": "@foreground", "dark": "@foreground" },
    "field-placeholder": { "light": "@muted", "dark": "@muted" },
    "field-border": { "light": "#7A8791", "dark": "#687B86", "hcLight": "#5F6D78", "hcDark": "#8A979F" },
    "success": { "light": "#177245", "dark": "#5AD58A", "hcLight": "#0F5E37", "hcDark": "#8BEBBE", "swift": "success" },
    "success-foreground": { "light": "#FFFFFF", "dark": "#071017" },
    "success-soft": { "light": "#EEF8F1", "dark": "#0E2418" },
    "success-soft-foreground": { "light": "@success", "dark": "@success" },
    "warning": { "light": "#8A6212", "dark": "#D9A441", "hcLight": "#6B4700", "hcDark": "#F6D27F", "swift": "warning" },
    "warning-foreground": { "light": "#FFFFFF", "dark": "#071017" },
    "warning-soft": { "light": "#FFF7E6", "dark": "#2A2212" },
    "warning-soft-foreground": { "light": "@warning", "dark": "@warning" },
    "danger": { "light": "#9F3039", "dark": "#F08A93", "hcLight": "#8A1F28", "hcDark": "#FFC9CE", "swift": "danger" },
    "danger-foreground": { "light": "#FFFFFF", "dark": "#071017" },
    "danger-soft": { "light": "#FDF2F3", "dark": "#2E171B" },
    "danger-soft-foreground": { "light": "@danger", "dark": "@danger" },
    "segment": { "light": "@accent", "dark": "@accent" },
    "segment-foreground": { "light": "@accent-foreground", "dark": "@accent-foreground" },
    "border": { "light": "#D9E1E6", "dark": "#263640", "hcLight": "#AAB5BC", "hcDark": "#40515B", "swift": "border" },
    "separator": { "light": "#E9EEF1", "dark": "#1B2931", "hcLight": "#D9E1E6", "hcDark": "#263640", "swift": "separator" },
    "focus": { "light": "@tint", "dark": "@tint" },
    "link": { "light": "@tint", "dark": "@tint" },
    "surface-shadow": { "light": "none", "dark": "none" },
    "field-shadow": { "light": "none", "dark": "none" },
    "overlay-shadow": { "light": "0 16px 48px rgba(20, 40, 50, 0.14)", "dark": "0 16px 48px rgba(0, 0, 0, 0.5)" },
    "tint": { "light": "#007088", "dark": "#22D3EE", "hcLight": "#00566B", "hcDark": "#A5F3FC", "tw": true, "swift": "tint" },
    "tint-foreground": { "light": "#FFFFFF", "dark": "#071017", "tw": true },
    "foreground-secondary": { "light": "#3E4D57", "dark": "#C8D1D6", "hcLight": "#071017", "hcDark": "#FFFFFF", "tw": true, "swift": "foregroundSecondary" },
    "border-strong": { "light": "#7A8791", "dark": "#687B86", "hcLight": "#5F6D78", "hcDark": "#8A979F", "tw": true, "swift": "borderStrong" },
    "cat-1": { "light": "@foreground", "dark": "@foreground", "tw": true },
    "cat-2": { "light": "#4E5D68", "dark": "#AAB5BC", "tw": true },
    "cat-3": { "light": "@border-strong", "dark": "@border-strong", "tw": true },
    "chart-1": { "light": "@tint", "dark": "@tint" },
    "chart-2": { "light": "@muted", "dark": "@muted" },
    "chart-3": { "light": "@foreground-secondary", "dark": "@foreground-secondary" },
    "chart-4": { "light": "@separator", "dark": "@separator" },
    "chart-5": { "light": "@warning", "dark": "@warning" }
  },
  "twInline": [
    "accent-soft",
    "accent-soft-foreground",
    "success-soft",
    "success-soft-foreground",
    "warning-soft",
    "warning-soft-foreground",
    "danger-soft",
    "danger-soft-foreground"
  ],
  "twDerived": {
    "$comment": "Overrides for HeroUI-derived --color-* keys, emitted into the same `@theme inline static` block. Uniwind's rt.colorMix lerps in sRGB and ignores HeroUI's second weight: light --color-warning-hover would be #96722A (white Toast action label 4.43:1) and --color-field-hover #E8E9EA (muted 4.38:1).",
    "warning-hover": "color-mix(in oklab, var(--warning) 90%, black)",
    "field-hover": "var(--surface-secondary)"
  },
  "heroDerived": {
    "$comment": "Mirror of every --color-* that heroui-native's styles/theme.css derives with color-mix() (identical in 1.0.8, 1.0.9 and 1.0.10; `check --css` fails when the installed theme.css differs). On web, useThemeColor reads these through getComputedStyle, and HeroUI's colour parser rejects the color-mix() string (Button press highlight, Toast). `gen` therefore writes a web-only block with each colour as hex, mixed in OKLab exactly as the browser mixes it, after the kit's own overrides (twInline, twDerived): an override that is a plain var() needs no pin, and a color-mix() override (warning-hover) is pinned with the kit's formula. Native never sees the block.",
    "surface-hover": "color-mix(in oklab, var(--surface) 92%, var(--surface-foreground) 8%)",
    "background-secondary": "color-mix(in oklab, var(--background) 96%, var(--foreground) 4%)",
    "background-tertiary": "color-mix(in oklab, var(--background) 92%, var(--foreground) 8%)",
    "default-hover": "color-mix(in oklab, var(--default) 96%, var(--default-foreground) 4%)",
    "accent-hover": "color-mix(in oklab, var(--accent) 90%, var(--accent-foreground) 10%)",
    "success-hover": "color-mix(in oklab, var(--success) 90%, var(--success-foreground) 10%)",
    "warning-hover": "color-mix(in oklab, var(--warning) 90%, var(--warning-foreground) 10%)",
    "danger-hover": "color-mix(in oklab, var(--danger) 90%, var(--danger-foreground) 10%)",
    "field-hover": "color-mix(in oklab, var(--field-background, var(--default)) 90%, var(--field-foreground, var(--foreground)) 2%)",
    "field-border-hover": "color-mix(in oklab, var(--field-border, var(--border)) 88%, var(--field-foreground, var(--foreground)) 10%)",
    "field-border-focus": "color-mix(in oklab, var(--field-border, var(--border)) 74%, var(--field-foreground, var(--foreground)) 22%)",
    "default-soft": "color-mix(in oklab, var(--default) 50%, transparent)",
    "default-soft-hover": "color-mix(in oklab, var(--default) 60%, transparent)",
    "accent-soft": "color-mix(in oklab, var(--accent) 15%, transparent)",
    "accent-soft-foreground": "color-mix(in oklab, var(--accent) 80%, var(--foreground) 20%)",
    "accent-soft-hover": "color-mix(in oklab, var(--accent) 20%, transparent)",
    "danger-soft": "color-mix(in oklab, var(--danger) 15%, transparent)",
    "danger-soft-foreground": "color-mix(in oklab, var(--danger) 80%, var(--foreground) 20%)",
    "danger-soft-hover": "color-mix(in oklab, var(--danger) 20%, transparent)",
    "warning-soft": "color-mix(in oklab, var(--warning) 15%, transparent)",
    "warning-soft-foreground": "color-mix(in oklab, var(--warning) 65%, var(--foreground) 35%)",
    "warning-soft-hover": "color-mix(in oklab, var(--warning) 20%, transparent)",
    "success-soft": "color-mix(in oklab, var(--success) 15%, transparent)",
    "success-soft-foreground": "color-mix(in oklab, var(--success) 70%, var(--foreground) 30%)",
    "success-soft-hover": "color-mix(in oklab, var(--success) 20%, transparent)",
    "separator-secondary": "color-mix(in oklab, var(--surface) 85%, var(--surface-foreground) 15%)",
    "separator-tertiary": "color-mix(in oklab, var(--surface) 81%, var(--surface-foreground) 19%)",
    "border-secondary": "color-mix(in oklab, var(--surface) 78%, var(--surface-foreground) 22%)",
    "border-tertiary": "color-mix(in oklab, var(--surface) 66%, var(--surface-foreground) 34%)"
  },
  "native": {
    "$comment": "Read by targets/*/expo-target.config.js. $accent backs Color.accentColor and the global accent build setting.",
    "accent": "#22D3EE",
    "widgetBackground": { "light": "#FFFFFF", "dark": "#0D171E" },
    "singleHexCyan": "#0891B2",
    "androidPrimary": "#007088"
  },
  "peers": {
    "$comment": "Range check; `check` WARNS on mismatch (does not fail). The heroui/uniwind upgrade is a separate owner-run install commit.",
    "heroui-native": ">=1.0.8 <1.1.0",
    "heroui-native-pro": "1.0.0-beta.10",
    "uniwind": ">=1.11.0 <1.13.0",
    "tailwindcss": ">=4.3.2 <4.4.0",
    "@bacons/apple-targets": "5.0.0",
    "react-native-svg": ">=15.15.0",
    "expo-localization": ">=57.0.0"
  }
}
